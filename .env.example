# PayHere Payment Gateway Configurations
# Mode: "sandbox" (for testing) or "production" (for live transactions)
VITE_PAYHERE_ENV=sandbox

# Your PayHere Merchant ID (obtain from PayHere Merchant Portal)
VITE_PAYHERE_MERCHANT_ID=1237483

# Backend API base URL
VITE_API_URL=http://localhost:3000

# Webhook notification URL (handled by your backend)
VITE_PAYHERE_NOTIFY_URL=http://localhost:3000/api/v1/payhere/notify
